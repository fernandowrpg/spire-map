{{!-- Controle de revelação — Spire Map --}}
<div class="spire-reveal-layout">

  {{#unless hasMap}}
    <div class="spire-empty">
      <i class="fa-solid fa-map-location-dot"></i>
      <p>{{localize "SPIREMAP.reveal.noMap"}}</p>
      <p class="hint">{{localize "SPIREMAP.reveal.noMapHint"}} <strong>{{sceneName}}</strong></p>
    </div>
  {{else}}

    <header class="spire-reveal__head">
      <div class="spire-reveal__title">
        <strong>{{sceneName}}</strong>
        <span class="hint">#{{seed}}</span>
      </div>
      <div class="spire-reveal__bar" role="img"
           aria-label="{{summary.revealed}}/{{summary.total}}">
        <div class="spire-reveal__fill" style="width: {{summary.percent}}%"></div>
      </div>
      <span class="spire-reveal__count">
        {{summary.revealed}}/{{summary.total}} ({{summary.percent}}%)
      </span>
    </header>

    {{#unless secret}}
      <p class="spire-warn">
        <i class="fa-solid fa-triangle-exclamation"></i>
        {{localize "SPIREMAP.reveal.secretOff"}}
      </p>
    {{/unless}}

    <div class="spire-reveal__controls">
      <label class="spire-field spire-field--tiny">
        <span>{{localize "SPIREMAP.fields.revealMode"}}</span>
        <select name="__mode">
          {{#each modeOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
          {{/each}}
        </select>
      </label>
      <label class="spire-field spire-field--tiny">
        <span>{{localize "SPIREMAP.fields.revealLookahead"}}</span>
        <input type="number" name="__lookahead" value="{{lookahead}}" min="0" max="5" step="1">
      </label>
      <span class="spire-footer__spacer"></span>
      <button type="button" class="spire-btn spire-btn--ghost" data-action="spireStepBack"
              data-tooltip="{{localize 'SPIREMAP.reveal.stepBackHint'}}">
        <i class="fa-solid fa-rotate-left"></i> {{localize "SPIREMAP.reveal.stepBack"}}
      </button>
      <button type="button" class="spire-btn spire-btn--ghost" data-action="spireRevealAll">
        <i class="fa-solid fa-eye"></i> {{localize "SPIREMAP.reveal.revealAll"}}
      </button>
      <button type="button" class="spire-btn spire-btn--ghost" data-action="spireHideUnvisited">
        <i class="fa-solid fa-eye-slash"></i> {{localize "SPIREMAP.reveal.hideUnvisited"}}
      </button>
      <button type="button" class="spire-icon-btn" data-action="spireResync"
              data-tooltip="{{localize 'SPIREMAP.reveal.resync'}}">
        <i class="fa-solid fa-arrows-rotate"></i>
      </button>
      <button type="button" class="spire-icon-btn spire-icon-btn--danger" data-action="spireReset"
              data-tooltip="{{localize 'SPIREMAP.reveal.reset'}}">
        <i class="fa-solid fa-trash-arrow-up"></i>
      </button>
    </div>

    <div class="spire-reveal__body">

      <div class="spire-reveal__mapcol">
        <div class="spire-reveal__stagebar">
          {{#if currentLabel}}
            <span class="spire-reveal__here">
              <i class="fa-solid fa-location-dot"></i>
              {{localize "SPIREMAP.reveal.hereAt"}}
              <span class="spire-chip" style="background:{{currentLabel.fill}};color:{{currentLabel.color}}">{{currentLabel.symbol}}</span>
              <strong>{{currentLabel.label}}</strong>
              <span class="hint">{{localize "SPIREMAP.preview.floor"}} {{currentLabel.floor}}</span>
            </span>
          {{else}}
            <span class="hint"><i class="fa-solid fa-flag"></i> {{localize "SPIREMAP.reveal.notStarted"}}</span>
          {{/if}}
          <span class="spire-footer__spacer"></span>
          <span class="spire-zoom-readout">{{zoomPercent}}%</span>
          <button type="button" class="spire-icon-btn" data-action="spireFit"
                  data-tooltip="{{localize 'SPIREMAP.buttons.fit'}}">
            <i class="fa-solid fa-expand"></i>
          </button>
        </div>

        <div class="spire-reveal__stage"></div>

        <p class="hint spire-hint--center">{{localize "SPIREMAP.reveal.mapHint"}}</p>
      </div>

      <aside class="spire-reveal__side">

        <h3 class="spire-legend">{{localize "SPIREMAP.reveal.options"}}</h3>
        {{#if available.length}}
          <div class="spire-choices">
            {{#each available}}
              <button type="button" class="spire-choice" data-action="spireChoose" data-node-id="{{id}}">
                <span class="spire-chip" style="background:{{fill}};color:{{color}}">{{symbol}}</span>
                <span class="spire-choice__label">
                  <strong>{{label}}</strong>
                  <span class="hint">{{localize "SPIREMAP.preview.floor"}} {{floor}} · {{localize "SPIREMAP.journal.column"}} {{col}}</span>
                </span>
                {{#unless revealed}}<i class="fa-solid fa-lock" data-tooltip="{{localize 'SPIREMAP.reveal.stateHidden'}}"></i>{{/unless}}
                <i class="fa-solid fa-chevron-right"></i>
              </button>
            {{/each}}
          </div>
          <p class="hint">{{localize "SPIREMAP.reveal.optionsHint"}}</p>
        {{else}}
          <p class="hint">{{localize "SPIREMAP.reveal.noOptions"}}</p>
        {{/if}}

        {{#if selected}}
          <h3 class="spire-legend">{{localize "SPIREMAP.reveal.selected"}}</h3>
          <div class="spire-selected">
            <header>
              <span class="spire-chip" style="background:{{selected.fill}};color:{{selected.color}}">{{selected.symbol}}</span>
              <strong>{{selected.label}}</strong>
              <span class="hint">{{localize "SPIREMAP.preview.floor"}} {{selected.floor}}</span>
            </header>
            <p class="hint">{{localize "SPIREMAP.reveal.state"}}: <strong>{{selected.stateLabel}}</strong></p>
            <div class="spire-toolbar spire-toolbar--wrap">
              <button type="button" class="spire-btn" data-action="spireToggle" data-node-id="{{selected.id}}">
                {{#if selected.revealed}}
                  <i class="fa-solid fa-eye-slash"></i> {{localize "SPIREMAP.reveal.hideNode"}}
                {{else}}
                  <i class="fa-solid fa-eye"></i> {{localize "SPIREMAP.reveal.revealNode"}}
                {{/if}}
              </button>
              {{#if selected.isAvailable}}
                <button type="button" class="spire-btn spire-btn--primary" data-action="spireChoose" data-node-id="{{selected.id}}">
                  <i class="fa-solid fa-shoe-prints"></i> {{localize "SPIREMAP.reveal.choose"}}
                </button>
              {{else}}
                <button type="button" class="spire-btn spire-btn--ghost" data-action="spireForceMove" data-node-id="{{selected.id}}"
                        data-tooltip="{{localize 'SPIREMAP.reveal.forceHint'}}">
                  <i class="fa-solid fa-shoe-prints"></i> {{localize "SPIREMAP.reveal.force"}}
                </button>
              {{/if}}
            </div>
          </div>
        {{/if}}

        <h3 class="spire-legend">{{localize "SPIREMAP.reveal.floors"}}</h3>
        <div class="spire-reveal__list">
          {{#each floors}}
            <div class="spire-floorrow {{#if hasCurrent}}is-current{{/if}}">
              <span class="spire-floorrow__num">
                {{#if isTop}}★{{else}}{{floor}}{{/if}}
              </span>
              <span class="spire-floorrow__nodes">
                {{#each nodes}}
                  <button type="button"
                          class="spire-nodechip state-{{state}}"
                          data-action="spireSelect" data-node-id="{{id}}"
                          data-tooltip="{{label}} — {{stateLabel}}"
                          style="{{#unless isHidden}}background:{{fill}};color:{{color}}{{/unless}}">
                    {{#if isHidden}}?{{else}}{{symbol}}{{/if}}
                  </button>
                {{/each}}
              </span>
              <button type="button" class="spire-icon-btn spire-floorrow__eye" data-action="spireRevealFloor"
                      data-floor="{{floor}}" data-tooltip="{{localize 'SPIREMAP.reveal.revealFloor'}}"
                      {{#if allRevealed}}disabled{{/if}}>
                <i class="fa-solid fa-eye"></i>
              </button>
            </div>
          {{/each}}
        </div>
      </aside>
    </div>
  {{/unless}}
</div>
