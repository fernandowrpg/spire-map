{{!-- Controle de revelação — Spire Map --}}
<div class="spire-reveal-layout">

  {{#unless hasMap}}
    <div class="spire-empty">
      <i class="fa-solid fa-map-location-dot"></i>
      <p>{{localize "SPIREMAP.reveal.noMap"}}</p>
      <p class="hint">{{localize "SPIREMAP.reveal.noMapHint"}} <strong>{{sceneName}}</strong></p>
    </div>
  {{else}}

    <header class="spire-reveal__head">
      <div class="spire-reveal__title">
        <strong>{{sceneName}}</strong>
        <span class="hint">#{{seed}}</span>
      </div>
      <div class="spire-reveal__bar" role="img"
           aria-label="{{summary.revealed}}/{{summary.total}}">
        <div class="spire-reveal__fill" style="width: {{summary.percent}}%"></div>
      </div>
      <span class="spire-reveal__count">
        {{summary.revealed}}/{{summary.total}} ({{summary.percent}}%)
      </span>
      {{#if secretPathCount}}
        <span class="spire-badge spire-badge--secret" data-tooltip="{{localize 'SPIREMAP.secretPath.countHint'}}">
          <i class="fa-solid fa-key"></i> {{secretPathsOpen}}/{{secretPathCount}}
        </span>
      {{/if}}
    </header>

    {{#if viewingElsewhere}}
      <div class="spire-box spire-nodescene__away">
        <p>
          <i class="fa-solid fa-map"></i>
          {{localize "SPIREMAP.nodeScene.away" name=viewedName}}
        </p>
        <button type="button" class="spire-btn spire-btn--primary" data-action="spireBackToMap"
                data-tooltip="{{localize 'SPIREMAP.nodeScene.backHint'}}">
          <i class="fa-solid fa-diagram-project"></i> {{localize "SPIREMAP.nodeScene.back"}}
        </button>
      </div>
    {{/if}}

    {{#unless secret}}
      <p class="spire-warn">
        <i class="fa-solid fa-triangle-exclamation"></i>
        {{localize "SPIREMAP.reveal.secretOff"}}
      </p>
    {{/unless}}

    <div class="spire-reveal__controls">
      <label class="spire-field spire-field--tiny">
        <span>{{localize "SPIREMAP.fields.revealMode"}}</span>
        <select name="__mode">
          {{#each modeOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
          {{/each}}
        </select>
      </label>
      <label class="spire-field spire-field--tiny">
        <span>{{localize "SPIREMAP.fields.revealLookahead"}}</span>
        <input type="number" name="__lookahead" value="{{lookahead}}" min="0" max="5" step="1">
      </label>
      <span class="spire-footer__spacer"></span>
      <button type="button" class="spire-btn spire-btn--ghost" data-action="spireStepBack"
              data-tooltip="{{localize 'SPIREMAP.reveal.stepBackHint'}}">
        <i class="fa-solid fa-rotate-left"></i> {{localize "SPIREMAP.reveal.stepBack"}}
      </button>
      <button type="button" class="spire-btn spire-btn--ghost" data-action="spireRevealAll">
        <i class="fa-solid fa-eye"></i> {{localize "SPIREMAP.reveal.revealAll"}}
      </button>
      <button type="button" class="spire-btn spire-btn--ghost" data-action="spireHideUnvisited">
        <i class="fa-solid fa-eye-slash"></i> {{localize "SPIREMAP.reveal.hideUnvisited"}}
      </button>
      <button type="button" class="spire-icon-btn" data-action="spireResync"
              data-tooltip="{{localize 'SPIREMAP.reveal.resync'}}">
        <i class="fa-solid fa-arrows-rotate"></i>
      </button>
      <button type="button" class="spire-icon-btn spire-icon-btn--danger" data-action="spireReset"
              data-tooltip="{{localize 'SPIREMAP.reveal.reset'}}">
        <i class="fa-solid fa-trash-arrow-up"></i>
      </button>
    </div>

    <div class="spire-reveal__body">

      <div class="spire-reveal__mapcol">
        <div class="spire-reveal__stagebar">
          {{#if currentLabel}}
            <span class="spire-reveal__here">
              <i class="fa-solid fa-location-dot"></i>
              {{localize "SPIREMAP.reveal.hereAt"}}
              <span class="spire-chip" style="background:{{currentLabel.fill}};color:{{currentLabel.color}}">{{currentLabel.symbol}}</span>
              <strong>{{#if currentLabel.alias}}{{currentLabel.alias}} — {{/if}}{{currentLabel.label}}</strong>
              <span class="hint">{{localize "SPIREMAP.preview.floor"}} {{currentLabel.floor}}</span>
            </span>
          {{else}}
            <span class="hint"><i class="fa-solid fa-flag"></i> {{localize "SPIREMAP.reveal.notStarted"}}</span>
          {{/if}}
          <span class="spire-footer__spacer"></span>
          <span class="spire-zoom-readout">{{zoomPercent}}%</span>
          <button type="button" class="spire-icon-btn" data-action="spireFit"
                  data-tooltip="{{localize 'SPIREMAP.buttons.fit'}}">
            <i class="fa-solid fa-expand"></i>
          </button>
        </div>

        <div class="spire-reveal__stage"></div>

        <p class="hint spire-hint--center">{{localize "SPIREMAP.reveal.mapHint"}}</p>
      </div>

      <aside class="spire-reveal__side">

        <h3 class="spire-legend">{{localize "SPIREMAP.reveal.options"}}</h3>
        {{#if available.length}}
          <div class="spire-box spire-votebox">
            {{#if vote}}
              <p>
                <i class="fa-solid fa-check-to-slot"></i>
                <strong>{{localize "SPIREMAP.vote.open"}}</strong>
                <span class="spire-badge">{{vote.total}}/{{vote.expected}}</span>
                {{#if vote.tie}}<span class="spire-badge spire-badge--secret">{{localize "SPIREMAP.vote.tieShort"}}</span>{{/if}}
              </p>
              <div class="spire-toolbar spire-toolbar--wrap">
                <button type="button" class="spire-btn spire-btn--primary" data-action="spireCloseVote"
                        data-tooltip="{{localize 'SPIREMAP.vote.closeHint'}}">
                  <i class="fa-solid fa-gavel"></i> {{localize "SPIREMAP.vote.close"}}
                </button>
                <button type="button" class="spire-btn spire-btn--ghost" data-action="spireCancelVote">
                  <i class="fa-solid fa-xmark"></i> {{localize "SPIREMAP.vote.cancel"}}
                </button>
              </div>
            {{else}}
              <button type="button" class="spire-btn" data-action="spireStartVote"
                      data-tooltip="{{localize 'SPIREMAP.vote.startHint'}}">
                <i class="fa-solid fa-check-to-slot"></i> {{localize "SPIREMAP.vote.start"}}
              </button>
            {{/if}}
          </div>
          <div class="spire-choices">
            {{#each available}}
              <button type="button" class="spire-choice" data-action="spireChoose" data-node-id="{{id}}">
                <span class="spire-chip" style="background:{{fill}};color:{{color}}">{{symbol}}</span>
                <span class="spire-choice__label">
                  <strong>{{#if alias}}{{alias}} — {{/if}}{{label}}</strong>
                  <span class="hint">{{localize "SPIREMAP.preview.floor"}} {{floor}} · {{localize "SPIREMAP.journal.column"}} {{col}}</span>
                </span>
                {{#if secretPath}}<i class="fa-solid fa-key" data-tooltip="{{localize 'SPIREMAP.secretPath.node'}}"></i>{{/if}}
                {{#if hasScene}}<i class="fa-solid fa-map" data-tooltip="{{localize 'SPIREMAP.nodeScene.hasScene'}}"></i>{{/if}}
                {{#unless revealed}}<i class="fa-solid fa-lock" data-tooltip="{{localize 'SPIREMAP.reveal.stateHidden'}}"></i>{{/unless}}
                {{#if ../vote}}
                  <span class="spire-vote__count {{#if isLeader}}is-leader{{/if}}" data-tooltip="{{voters}}">{{votes}}</span>
                {{/if}}
                <i class="fa-solid fa-chevron-right"></i>
              </button>
            {{/each}}
          </div>
          <p class="hint">{{localize "SPIREMAP.reveal.optionsHint"}}</p>
        {{else}}
          <p class="hint">{{localize "SPIREMAP.reveal.noOptions"}}</p>
        {{/if}}

        {{#if selected}}
          <h3 class="spire-legend">{{localize "SPIREMAP.reveal.selected"}}</h3>
          <div class="spire-selected">
            <header>
              <span class="spire-chip" style="background:{{selected.fill}};color:{{selected.color}}">{{selected.symbol}}</span>
              <strong>{{selected.label}}</strong>
              <span class="hint">{{localize "SPIREMAP.preview.floor"}} {{selected.floor}}</span>
            </header>
            {{#if selected.alias}}<p class="spire-selected__alias">{{selected.alias}}</p>{{/if}}
            <p class="hint">{{localize "SPIREMAP.reveal.state"}}: <strong>{{selected.stateLabel}}</strong></p>
            <div class="spire-toolbar spire-toolbar--wrap">
              <button type="button" class="spire-btn" data-action="spireToggle" data-node-id="{{selected.id}}">
                {{#if selected.revealed}}
                  <i class="fa-solid fa-eye-slash"></i> {{localize "SPIREMAP.reveal.hideNode"}}
                {{else}}
                  <i class="fa-solid fa-eye"></i> {{localize "SPIREMAP.reveal.revealNode"}}
                {{/if}}
              </button>
              {{#if selected.isAvailable}}
                <button type="button" class="spire-btn spire-btn--primary" data-action="spireChoose" data-node-id="{{selected.id}}">
                  <i class="fa-solid fa-shoe-prints"></i> {{localize "SPIREMAP.reveal.choose"}}
                </button>
              {{else}}
                <button type="button" class="spire-btn spire-btn--ghost" data-action="spireForceMove" data-node-id="{{selected.id}}"
                        data-tooltip="{{localize 'SPIREMAP.reveal.forceHint'}}">
                  <i class="fa-solid fa-shoe-prints"></i> {{localize "SPIREMAP.reveal.force"}}
                </button>
              {{/if}}
            </div>

            {{!-- Cena do mundo associada ao nó: ativá-la leva os tokens dos jogadores para lá --}}
            <div class="spire-box spire-dropzone spire-nodescene" data-node-id="{{selected.id}}">
              <p>
                <i class="fa-solid fa-map"></i>
                <strong>{{localize "SPIREMAP.nodeScene.title"}}</strong>
                {{#if selected.nodeScene.active}}<span class="spire-badge">{{localize "SPIREMAP.nodeScene.isActive"}}</span>{{/if}}
              </p>
              <label class="spire-field">
                <span>{{localize "SPIREMAP.nodeScene.scene"}}</span>
                <select name="__nodeScene" data-node-id="{{selected.id}}">
                  <option value="">— {{localize "SPIREMAP.nodeScene.noneOption"}} —</option>
                  {{#each selected.sceneOptions}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                  {{/each}}
                </select>
              </label>
              {{#if selected.nodeScene}}
                {{#if selected.nodeScene.missing}}
                  <p class="spire-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "SPIREMAP.nodeScene.missing"}}</p>
                {{else}}
                  <div class="spire-toolbar spire-toolbar--wrap">
                    <button type="button" class="spire-btn spire-btn--primary" data-action="spireActivateScene"
                            data-node-id="{{selected.id}}" data-tooltip="{{localize 'SPIREMAP.nodeScene.activateHint'}}">
                      <i class="fa-solid fa-person-walking-arrow-right"></i> {{localize "SPIREMAP.nodeScene.activate"}}
                    </button>
                    <button type="button" class="spire-btn spire-btn--ghost" data-action="spireViewScene"
                            data-node-id="{{selected.id}}" data-tooltip="{{localize 'SPIREMAP.nodeScene.viewHint'}}">
                      <i class="fa-solid fa-eye"></i> {{localize "SPIREMAP.nodeScene.view"}}
                    </button>
                  </div>
                {{/if}}
              {{/if}}
              <p class="hint">{{localize "SPIREMAP.nodeScene.hint"}}</p>
            </div>

            {{!-- Caminho secreto: o nó faz parte de um, ou é a chave de um --}}
            {{#if selected.secretPath}}
              <div class="spire-box spire-box--secret">
                <p>
                  <i class="fa-solid fa-key"></i>
                  {{localize "SPIREMAP.secretPath.node"}} #{{selected.secretPath}} —
                  <strong>{{#if selected.isLocked}}{{localize "SPIREMAP.secretPath.locked"}}{{else}}{{localize "SPIREMAP.secretPath.open"}}{{/if}}</strong>
                </p>
                <button type="button" class="spire-btn spire-btn--ghost" data-action="spireToggleSecret"
                        data-path-id="{{selected.secretPath}}">
                  {{#if selected.isLocked}}
                    <i class="fa-solid fa-lock-open"></i> {{localize "SPIREMAP.secretPath.unlock"}}
                  {{else}}
                    <i class="fa-solid fa-lock"></i> {{localize "SPIREMAP.secretPath.lock"}}
                  {{/if}}
                </button>
              </div>
            {{/if}}
            {{#each selected.secretKeys}}
              <div class="spire-box spire-box--secret">
                <p>
                  <i class="fa-solid fa-key"></i>
                  {{localize "SPIREMAP.secretPath.keyOf"}} #{{id}} —
                  <strong>{{#if unlocked}}{{localize "SPIREMAP.secretPath.open"}}{{else}}{{localize "SPIREMAP.secretPath.locked"}}{{/if}}</strong>
                </p>
                <button type="button" class="spire-btn spire-btn--ghost" data-action="spireToggleSecret" data-path-id="{{id}}">
                  {{#if unlocked}}
                    <i class="fa-solid fa-lock"></i> {{localize "SPIREMAP.secretPath.lock"}}
                  {{else}}
                    <i class="fa-solid fa-lock-open"></i> {{localize "SPIREMAP.secretPath.unlock"}}
                  {{/if}}
                </button>
              </div>
            {{/each}}

            {{!-- Sala "?": o tipo é rolado fora do Foundry e definido aqui --}}
            {{#if selected.resolvable}}
              <div class="spire-box spire-resolve">
                <p>
                  <i class="fa-solid fa-circle-question"></i>
                  <strong>{{localize "SPIREMAP.resolve.title"}}</strong>
                  {{#if selected.isResolved}}<span class="spire-badge">{{localize "SPIREMAP.resolve.defined"}}</span>{{/if}}
                </p>
                <label class="spire-field">
                  <span>{{localize "SPIREMAP.resolve.type"}}</span>
                  <select name="__resType">
                    {{#each selected.typeOptions}}
                      <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                    {{/each}}
                  </select>
                </label>
                <label class="spire-field">
                  <span>{{localize "SPIREMAP.resolve.alias"}}</span>
                  <input type="text" name="__resAlias" maxlength="80" value="{{selected.resolution.alias}}"
                         placeholder="{{localize 'SPIREMAP.resolve.aliasPlaceholder'}}">
                </label>
                <label class="spire-field">
                  <span>{{localize "SPIREMAP.resolve.description"}}</span>
                  <textarea name="__resDesc" rows="3" maxlength="4000">{{selected.resolution.description}}</textarea>
                </label>
                <div class="spire-toolbar spire-toolbar--wrap">
                  <button type="button" class="spire-btn spire-btn--primary" data-action="spireResolve" data-node-id="{{selected.id}}">
                    <i class="fa-solid fa-check"></i> {{localize "SPIREMAP.resolve.apply"}}
                  </button>
                  {{#if selected.resolution}}
                    <button type="button" class="spire-btn spire-btn--ghost" data-action="spireUnresolve" data-node-id="{{selected.id}}">
                      <i class="fa-solid fa-rotate-left"></i> {{localize "SPIREMAP.resolve.clear"}}
                    </button>
                  {{/if}}
                </div>
                <p class="hint">{{localize "SPIREMAP.resolve.hint"}}</p>
              </div>
            {{/if}}

            {{!-- Boss: arraste o adversário para cá --}}
            {{#if selected.isBossNode}}
              <div class="spire-box spire-dropzone" data-node-id="{{selected.id}}">
                {{#if selected.adversary}}
                  <div class="spire-adversary {{#if selected.adversary.defeated}}is-defeated{{/if}}">
                    {{#if selected.adversary.img}}<img src="{{selected.adversary.img}}" alt="">{{/if}}
                    <span class="spire-adversary__name">
                      <strong>{{selected.adversary.name}}</strong>
                      <span class="hint">
                        {{#if selected.adversary.defeated}}{{localize "SPIREMAP.boss.defeated"}}{{else}}{{localize "SPIREMAP.boss.adversary"}}{{/if}}
                      </span>
                    </span>
                    {{#if selected.adversary.uuid}}
                      <button type="button" class="spire-icon-btn" data-action="spireOpenAdversary"
                              data-uuid="{{selected.adversary.uuid}}" data-tooltip="{{localize 'SPIREMAP.boss.openSheet'}}">
                        <i class="fa-solid fa-id-card"></i>
                      </button>
                    {{/if}}
                    <button type="button" class="spire-icon-btn spire-icon-btn--danger" data-action="spireClearAdversary"
                            data-node-id="{{selected.id}}" data-tooltip="{{localize 'SPIREMAP.boss.remove'}}">
                      <i class="fa-solid fa-xmark"></i>
                    </button>
                  </div>
                  <button type="button" class="spire-btn {{#unless selected.adversary.defeated}}spire-btn--primary{{/unless}}"
                          data-action="spireDefeat" data-node-id="{{selected.id}}">
                    {{#if selected.adversary.defeated}}
                      <i class="fa-solid fa-rotate-left"></i> {{localize "SPIREMAP.boss.undoDefeat"}}
                    {{else}}
                      <i class="fa-solid fa-skull"></i> {{localize "SPIREMAP.boss.markDefeated"}}
                    {{/if}}
                  </button>
                {{else}}
                  <p class="spire-dropzone__empty">
                    <i class="fa-solid fa-dragon"></i> {{localize "SPIREMAP.boss.dropHere"}}
                  </p>
                {{/if}}
                <p class="hint">{{localize "SPIREMAP.boss.hint"}}</p>
              </div>
            {{/if}}
          </div>
        {{/if}}

        {{#if history.length}}
          <details class="spire-history">
            <summary>
              <i class="fa-solid fa-skull"></i> {{localize "SPIREMAP.boss.history"}} ({{history.length}})
            </summary>
            <ul>
              {{#each history}}
                <li>
                  {{#if img}}<img src="{{img}}" alt="">{{/if}}
                  <span class="spire-history__text">
                    <strong>{{name}}</strong>
                    <span class="hint">{{scene}} · {{localize "SPIREMAP.fields.act"}} {{act}}{{#if when}} · {{when}}{{/if}}</span>
                  </span>
                  <button type="button" class="spire-icon-btn" data-action="spireClearHistory" data-index="{{index}}"
                          data-tooltip="{{localize 'SPIREMAP.boss.removeEntry'}}">
                    <i class="fa-solid fa-xmark"></i>
                  </button>
                </li>
              {{/each}}
            </ul>
            <button type="button" class="spire-btn spire-btn--ghost" data-action="spireClearHistory">
              <i class="fa-solid fa-trash"></i> {{localize "SPIREMAP.boss.clearHistory"}}
            </button>
          </details>
        {{/if}}

        <h3 class="spire-legend">{{localize "SPIREMAP.reveal.floors"}}</h3>
        <div class="spire-reveal__list">
          {{#each floors}}
            <div class="spire-floorrow {{#if hasCurrent}}is-current{{/if}}">
              <span class="spire-floorrow__num">
                {{#if isTop}}★{{else}}{{floor}}{{/if}}
              </span>
              <span class="spire-floorrow__nodes">
                {{#each nodes}}
                  <button type="button"
                          class="spire-nodechip state-{{state}}{{#if secretPath}} is-secretpath{{/if}}{{#if isLocked}} is-locked{{/if}}"
                          data-action="spireSelect" data-node-id="{{id}}"
                          data-tooltip="{{#if alias}}{{alias}} — {{/if}}{{label}} — {{stateLabel}}"
                          style="{{#unless isHidden}}background:{{fill}};color:{{color}}{{/unless}}">
                    {{#if isHidden}}?{{else}}{{symbol}}{{/if}}
                  </button>
                {{/each}}
              </span>
              <button type="button" class="spire-icon-btn spire-floorrow__eye" data-action="spireRevealFloor"
                      data-floor="{{floor}}" data-tooltip="{{localize 'SPIREMAP.reveal.revealFloor'}}"
                      {{#if allRevealed}}disabled{{/if}}>
                <i class="fa-solid fa-eye"></i>
              </button>
            </div>
          {{/each}}
        </div>
      </aside>
    </div>
  {{/unless}}
</div>
